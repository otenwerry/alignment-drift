# Subscription-harness variant of the p-hacking sandbox. Claude Code's inner Bash
# sandbox needs bubblewrap and socat so model-run commands cannot read OAuth login.
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    git \
    ripgrep \
    socat \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    pandas==2.2.3 \
    numpy==2.1.3 \
    scipy==1.14.1 \
    statsmodels==0.14.4 \
    matplotlib==3.9.2

WORKDIR /workspace
